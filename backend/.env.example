# ─── Application ──────────────────────────────────────────────────────────────
APP_VERSION=1.0.0
DEBUG=false

# ─── Database ─────────────────────────────────────────────────────────────────
# Async URL for the app (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://nurtlina:password@localhost:5432/nurtlina
# Sync URL for Alembic migrations (psycopg2 driver)
DATABASE_SYNC_URL=postgresql+psycopg2://nurtlina:password@localhost:5432/nurtlina

# ─── Firebase ─────────────────────────────────────────────────────────────────
# Path to the Firebase service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=/secrets/firebase-service-account.json
# Firebase project ID (also used by firebase-admin)
FIREBASE_PROJECT_ID=nurtlina-prod

# ─── Google Play ──────────────────────────────────────────────────────────────
# Path to Google service account JSON with Android Publisher API access
GOOGLE_PLAY_SERVICE_ACCOUNT_PATH=/secrets/google-play-service-account.json
GOOGLE_PLAY_PACKAGE_NAME=com.nurtlina.app

# ─── Object Storage (optional, for exports) ───────────────────────────────────
# GCS_BUCKET_NAME=nurtlina-exports
# GCS_EXPORT_EXPIRY_SECONDS=3600

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list; use * only in local dev
ALLOWED_ORIGINS=*
