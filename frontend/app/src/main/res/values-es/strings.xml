    <!-- Disclaimer and Safety -->
    <string name="disclaimer_full">Esta aplicación proporciona recordatorios y herramientas de seguimiento basadas en guías públicas seleccionadas. No proporciona consejo médico y no puede determinar si la leche es segura. Sigue siempre las instrucciones de la etiqueta de la leche de fórmula, las pautas de salud locales y los consejos de tu pediatra. En caso de duda, descarta la leche.</string>
    <string name="disclaimer_short">Esta aplicación es una herramienta de recordatorio, no un consejo médico.</string>
    <string name="safety_note_guideline">Según la guía seleccionada</string>
    <string name="safety_when_in_doubt">En caso de duda, descarta la leche.</string>
    <string name="safety_not_medical_advice">No es consejo médico. Sigue las instrucciones de la etiqueta de la fórmula y las indicaciones del pediatra.</string>

